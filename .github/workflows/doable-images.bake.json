{
  "group": {
    "doable": {
      "targets": ["migrate", "api", "ws", "web"]
    }
  },
  "target": {
    "doable-common": {
      "context": ".",
      "dockerfile": "deployment/docker/Dockerfile",
      "platforms": ["linux/amd64"]
    },
    "migrate": {
      "inherits": ["doable-common"],
      "target": "migrate",
      "tags": ["${PREFIX}-migrate:${TAG}", "${PREFIX}-migrate:latest"],
      "cache-from": ["type=gha,scope=doable-migrate"],
      "cache-to": ["type=gha,mode=min,scope=doable-migrate"]
    },
    "api": {
      "inherits": ["doable-common"],
      "target": "api",
      "tags": ["${PREFIX}-api:${TAG}", "${PREFIX}-api:latest"],
      "cache-from": ["type=gha,scope=doable-api"],
      "cache-to": ["type=gha,mode=min,scope=doable-api"]
    },
    "ws": {
      "inherits": ["doable-common"],
      "target": "ws",
      "tags": ["${PREFIX}-ws:${TAG}", "${PREFIX}-ws:latest"],
      "cache-from": ["type=gha,scope=doable-ws"],
      "cache-to": ["type=gha,mode=min,scope=doable-ws"]
    },
    "web": {
      "inherits": ["doable-common"],
      "target": "web",
      "tags": ["${PREFIX}-web:${TAG}", "${PREFIX}-web:latest"],
      "cache-from": ["type=gha,scope=doable-web"],
      "cache-to": ["type=gha,mode=min,scope=doable-web"]
    }
  }
}
